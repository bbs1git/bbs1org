# 数据库模式：sqlite、mysql 或 pgsql
COMPOSE_PROFILES=sqlite

# 网站对外访问端口
HTTP_PORT=8080

# 数据库主机：内置数据库留空，外部数据库填写地址
DB_HOST=

# 数据库端口：留空时 MySQL 使用 3306，PostgreSQL 使用 5432
DB_PORT=

# 数据库名称
DB_NAME=forum

# 数据库用户名
DB_USER=forum

# 数据库密码：使用 MySQL 或 PostgreSQL 时必须修改
DB_PASSWORD=change-this-password

# 管理员登录用户名
ADMIN_USERNAME=admin

# 管理员登录密码：设置后首次启动自动安装，留空则使用网页安装
ADMIN_PASSWORD=

# 管理员邮箱
ADMIN_EMAIL=admin@example.com

# 站点名称
SITE_NAME=我的论坛

# 默认版块名称
FORUM_NAME=默认版块
